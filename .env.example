# Local development only. Generate unique values; never commit .env or secrets/.
DB_PASSWORD=replace-with-a-long-random-database-password
DB_USERNAME=oauth2
DB_URL=jdbc:postgresql://localhost:5432/oauth2
OAUTH_ISSUER=http://localhost:9000
OAUTH_CLIENT_ID=user-management
OAUTH_CLIENT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OAUTH_REDIRECT_URI=http://127.0.0.1:8080/callback
JWT_JWK_FILE=secrets/jwk.json
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
